# ============================================================
# HappyKidsCK - Cấu hình tự động khi chạy trên Hosting (ByetHost)
#
# Cách hoạt động:
# - Chạy dưới máy local (localhost / XAMPP): hệ thống dùng backend/.env (CSDL local happykidsck)
# - Chạy trên hosting (tên miền thật): hệ thống TỰ ĐỘNG nạp đè tệp này lên trên backend/.env
#   (tự kế thừa APP_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_ALLOWED_EMAILS).
#
# Lưu ý: Tệp bắt đầu bằng dấu chấm nên đã bị .htaccess chặn tuyệt đối từ trình duyệt.
# ============================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=auto
FRONTEND_URL=auto
GOOGLE_REDIRECT_URI=auto
SESSION_SECURE=auto
LOG_LEVEL=warning

# --- Cơ sở dữ liệu MySQL trên Hosting (ByetHost) ---
DB_CONNECTION=mysql
DB_HOST=sql201.byethost16.com
DB_PORT=3306
DB_DATABASE=b16_43552462_happykid
DB_USERNAME=b16_43552462
# >>> CHỈ CẦN ĐIỀN MẬT KHẨU vPanel (MySQL) CỦA BẠN VÀO DÒNG DƯỚI ĐÂY <<<

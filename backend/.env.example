# ============================================================
# HappyKidsCK - Mẫu biến môi trường (LOCAL DEV)
# Sao chép thành .env rồi điền giá trị thật (không commit .env)
# Khi deploy production BẮT BUỘC đổi:
#   APP_ENV=production, APP_DEBUG=false, SESSION_SECURE=true,
#   DB_USERNAME/DB_PASSWORD riêng, APP_KEY có giá trị.
# Ứng dụng sẽ từ chối chạy nếu production còn cấu hình không an toàn.
# ============================================================

APP_NAME="HappyKidsCK"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/HeThongDiemDanhTre/backend/public
# Giao diện tĩnh (đích quay về sau khi đăng nhập Google); bỏ trống sẽ tự suy ra từ APP_URL
FRONTEND_URL=http://localhost/HeThongDiemDanhTre/frontend
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_LOCALE=vi
# Sinh key mới: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=

# --- Database ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=happykidsck
DB_USERNAME=root
DB_PASSWORD=

# --- Phiên đăng nhập ---
SESSION_NAME=happykidsck_session
SESSION_LIFETIME=120
SESSION_IDLE_MINUTES=30
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=Lax

# --- Google OAuth 2.0 (Super Admin) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/HeThongDiemDanhTre/backend/public/auth/google/callback
# Email Google được phép đăng nhập, phân tách bằng dấu phẩy
# Bắt buộc phải có ít nhất 1 email; để trống = tắt đăng nhập Google
GOOGLE_ALLOWED_EMAILS=dothienvu84tv@gmail.com

# --- Upload ảnh từ máy (tự nén & thu nhỏ còn ~30-60KB khi PHP có GD) ---
UPLOAD_MAX_SIZE_MB=2
UPLOAD_ALLOWED_EXT=jpg,jpeg,png,webp
UPLOAD_DIR=storage/uploads
UPLOAD_MAX_DIMENSION=480
UPLOAD_JPEG_QUALITY=78

# --- Log & sao lưu (tự dọn định kỳ để tránh đầy host miễn phí như ByetHost) ---
# Trên host production nên đặt LOG_LEVEL=warning để không ghi file log thừa
LOG_LEVEL=debug
LOG_KEEP_DAYS=14
DB_LOG_KEEP_DAYS=90
BACKUP_KEEP_DAYS=30

# --- Bảo mật bổ sung ---
SECURITY_MAX_BODY_KB=8192
SECURITY_MAX_EXECUTION_SECONDS=30
CSRF_CHECK_ORIGIN=true
# Từ chối request thay đổi dữ liệu không có Origin/Referer
CSRF_REQUIRE_SOURCE=true
# Origin bổ sung ngoài APP_URL/FRONTEND_URL (phân tách bằng dấu phẩy)
CSRF_TRUSTED_ORIGINS=
# Chỉ gửi HSTS khi chạy HTTPS và không phải môi trường local/debug
SECURITY_HSTS=true
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_LOGIN_ACCOUNT_MAX=5

# --- Cache phía máy chủ (Cache Aside, lưu file trong storage/cache) ---
CACHE_ENABLED=true
CACHE_TTL_SETTINGS=300
CACHE_TTL_BRANCHES=600
CACHE_TTL_PERMISSIONS=600
CACHE_TTL_USER_PERMISSIONS=120
CACHE_TTL_DASHBOARD=30

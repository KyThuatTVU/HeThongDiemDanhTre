# ============================================================
# HappyKidsCK - Mẫu cấu hình tự động khi chạy trên Hosting (ByetHost)
# Sao chép thành backend/.env.hosting rồi điền giá trị thật (KHÔNG commit .env.hosting)
# ============================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=auto
FRONTEND_URL=auto
GOOGLE_REDIRECT_URI=auto
SESSION_SECURE=auto
LOG_LEVEL=warning
APP_KEY=

# --- Google OAuth 2.0 (Super Admin) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAILS=

# --- Cơ sở dữ liệu MySQL trên Hosting (ByetHost) ---
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
